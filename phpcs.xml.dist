<?xml version="1.0"?>
<ruleset name="FA WP Speedup">
  <description>WordPress coding and security checks for runtime code.</description>
  <config name="minimum_supported_wp_version" value="6.5"/>
  <config name="testVersion" value="8.1-"/>
  <file>fa-wp-speedup.php</file>
  <file>uninstall.php</file>
  <file>includes</file>
  <arg name="extensions" value="php"/>
  <rule ref="WordPress"/>
</ruleset>
